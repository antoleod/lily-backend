NODE_ENV=development
PORT=4000
APP_NAME=Lily Backend
# Optional build commit SHA exposed in health and startup diagnostics.
BUILD_COMMIT=
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
BODY_SIZE_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API-key authentication is opt-in. Leave AUTH_API_KEY empty to disable it.
AUTH_API_KEY=
# Header clients use when API-key authentication is enabled.
AUTH_API_KEY_HEADER=x-api-key

# TRUST_PROXY accepts "false" (default), a non-negative integer hop count, or "loopback".
# Numeric values specify how many proxy hops to trust (for example, 1 for one reverse proxy).
# WARNING: TRUST_PROXY=true is intentionally rejected because trusting every proxy is unsafe.
TRUST_PROXY=false
